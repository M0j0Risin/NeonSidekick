<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NeonSidekick</AssemblyName>
    <RootNamespace>NeonSidekick</RootNamespace>
    <Version>0.4.0</Version>
    <!-- The copyright holder and the licence (GPL-3.0-or-later since 2026-09-20): the exe's version-info block carries them. -->
    <Authors>Christopher Nelson</Authors>
    <Copyright>Copyright (C) 2026 Christopher Nelson</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>

    <!-- The executable's icon. Generated from assets/icon.svg by tools/IconGen.cs and committed;
         ILC carries the managed assembly's Win32 resources into the native exe
         (Microsoft.NETCore.Native.targets passes the win32resourcemodule option). -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- NativeAOT. IsAotCompatible turns on the trim/AOT analyzers for OUR code so a reflection
         path fails at build time instead of in the published binary. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <OptimizationPreference>Speed</OptimizationPreference>

    <!--
      Compile for x86-64-v3 (AVX2, FMA, BMI). NativeAOT evaluates Avx.IsSupported at COMPILE time
      against this level; at the default baseline it is false on every machine, Whisper.net picks
      its noavx runtime, and transcription runs several times slower.
      Whisper.net.Runtime.NoAvx stays referenced regardless (see below).
    -->
    <IlcInstructionSet>x86-64-v3</IlcInstructionSet>

    <!-- Globalization on (2026-09-23; true until then): Microsoft.Data.SqlClient refuses to run in
         invariant mode ("Globalization Invariant Mode is not supported"; 7.1 has no switch past it, it
         maps each column's collation to a code page), and the SQL tools need it. On Windows the data
         is the OS's own icu.dll, so the exe grew 0.2 MB in the spike and ships no ICU of its own. The
         rule stands as it was: every parse/format in this codebase uses CultureInfo.InvariantCulture
         explicitly, and Program.cs pins the process's cultures to invariant before anything runs
         (App/CulturePin.cs), so a format that forgot one still prints what it printed before. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Reflection-based System.Text.Json is off even under the JIT, so a type missing from
         SettingsJsonContext throws in `dotnet test`, not only in the published exe. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- WinMM headers are typed pointers into unmanaged memory (Audio/WinMmAudioPlayback.cs);
         nothing is marshalled by value, which is the NAudio-under-AOT scar. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.3" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.3" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <!--
      Mandatory, not a portability nicety. If IlcInstructionSet is ever lowered, Avx.IsSupported
      becomes a compile-time FALSE and Whisper.net looks for a noavx runtime; without this package
      it finds nothing and both Silero VAD and transcription die with
      "AVX is not supported on this platform, and noavx runtime is not available".
    -->
    <PackageReference Include="Whisper.net.Runtime.NoAvx" Version="1.9.1" />
    <PackageReference Include="Vosk" Version="0.3.38" />
    <!--
      Images on the line (Files/ImageFile.cs): decode + downscale through Windows' own WIC codecs
      by function-pointer COM (no native DLL of its own, AOT-clean). MIT. ImageSharp was declined:
      Split License, and v4 refuses to build without a licence key.
    -->
    <PackageReference Include="PhotoSauce.MagicScaler" Version="0.15.0" />
    <!--
      Kokoro in-process (Speech/KokoroInProcessSynthesizer.cs, `TTS source` = in-process, 2026-09-16).
      KokoroSharp is the inference engine over ONNX Runtime (CPU only; the ORT version is the one
      KokoroSharp's managed dependency names). One ORT session per process, built from an absolute
      model path — never KokoroTTS.LoadModel(KModel…), which resolves "kokoro.onnx" against the
      CURRENT DIRECTORY and downloads 325 MB into it when it misses. NAudio, OpenTK.Audio.OpenAL
      and NumSharp arrive transitively; nothing here calls NAudio's devices (the audio rule stands:
      playback is Audio/WinMmAudioPlayback.cs), and KokoroSharp's OpenAL playback is never created.
    -->
    <PackageReference Include="KokoroSharp" Version="0.8.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.0" />
    <!--
      The Markdown reader behind the styled transcript (UI/Markdown/MarkdigParser.cs, `Transcript
      markdown`, 2026-09-16). CommonMark-compliant, pure managed, BSD-2-Clause; declares no AOT
      metadata but publishes with 0 IL warnings (probed under TrimmerSingleWarn=false). Only the
      parser is used: the rendering is UI/Markdown/MarkdownView.cs over the app's own AST.
    -->
    <PackageReference Include="Markdig" Version="1.3.2" />
    <!--
      The session store (Sessions/SessionStore.cs, `<profile>\sessions.db`, 2026-09-18): raw SQL
      over Microsoft.Data.Sqlite (trim- and AOT-clean since 8.0; no EF, no Dapper) with the
      SQLitePCLRaw e_sqlite3 bundle it pulls in — one native e_sqlite3.dll beside the exe, built
      with FTS5, which the full-text search over the turns needs. The smoke probe sessions:open
      is the proof on the published binary.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!--
      External MCP servers (Mcp/, App/McpSession.cs, `/mcp`, 2026-09-20): the official C# SDK's
      client half alone (`.Core`, no hosting or DI; Apache-2.0; declares IsAotCompatible and carries
      its own source-generated JSON context) over Microsoft.Extensions.AI.Abstractions, the same
      10.8.3 the chat client is on. Its StdioClientTransport starts and, on dispose, kills each
      stdio server's child process — the fourth process-start site in the app, owned by the SDK;
      HttpClientTransport keeps its own HttpClient (an MCP endpoint is the user's config like the
      LLM URL, never judged by LanPolicy). The smoke probe mcp:roundtrip is the proof on the
      published binary: an in-process server over a pipe, listed and called through McpTool.
    -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <!--
      The git tools (Git/, Llm/Tools/Git*Tool.cs, `Git tools`, 2026-09-20): local-only git over the
      repository at or under the working directory, in-process — no git.exe, no new process-start
      site, no hooks, no credential helper. MIT over libgit2 (GPL-2.0 with the linking exception),
      prebuilt for win-x64 by the NativeBinaries package pinned here explicitly (the Whisper.net +
      Whisper.net.Runtime shape: the native version is named in the project file and /about's row
      follows it) as one git2-<hash>.dll beside the exe. The interop is classic DllImport with
      ICustomMarshaler (supported by NativeAOT since .NET 7) and UnmanagedFunctionPointer callbacks;
      the library declares IsTrimmable but not IsAotCompatible, and Diff.Compare<T> has one open
      NativeAOT report (libgit2sharp#2082). The smoke probe git:roundtrip is the proof on the
      published binary, one leg per operation.
    -->
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
    <PackageReference Include="LibGit2Sharp.NativeBinaries" Version="2.0.324" />
    <!--
      The SQL tools (Sql/, Llm/Tools/Sql*Tool.cs, `SQL tools`, 2026-09-23): read-only queries on SQL
      Server over the connections of sql.json. MIT. SqlClient declares no AOT support and ILC reports
      its trim/AOT warnings (IL2104/IL3053, third-party, tolerated); the spike published and ran
      TCP + TLS, varchar under a SQL collation, decimal, binary and a named-pipe failure cleanly.
      On Windows it brings Microsoft.Data.SqlClient.SNI.dll (the native network layer, from the
      .SNI.runtime package) beside the exe; it cannot run under InvariantGlobalization (see above).
      ScriptDom is the T-SQL parser behind the read-only gate (Sql/SqlReadOnlyGate.cs): fully managed,
      MIT. The smoke probe sql:parse-and-sni is the proof on the published binary, and since 2026-10-03 the check
      mode sql-check against a server (the Oracle and MySQL checks' shape, come late).
    -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.107.0" />
    <!--
      The Oracle tools (Oracle/, Llm/Tools/Oracle*Tool.cs, `Oracle tools`, 2026-09-30): read-only queries on
      Oracle over the connections of oracle.json. ODP.NET Core, Oracle's free, fully managed driver (no
      Instant Client; its one P/Invoke is crypt32), under the Oracle Free Use Terms. It declares no AOT
      support either — Dotfuscated, reflection for its optional add-ons (cloud tokens, Kerberos, config
      files: not used here) — and ILC reports IL2104/IL3053 and IL3000s naming OracleInternal (third-party,
      tolerated). The spike against Oracle Free 23.26 ran connect, binds, every scalar type, CLOB/BLOB/RAW,
      TIMESTAMP WITH TIME ZONE, intervals, BOOLEAN, async reads, cancel and ORA-01013 cleanly — except
      that the trimmed assembly threw NullReferenceException from OracleCommand.InitialLONGFetchSize and read
      LONG columns (the dictionary's DATA_DEFAULT, SEARCH_CONDITION, ALL_VIEWS.TEXT) as empty. Rooted whole
      (TrimmerRootAssembly below, ~9 MB), both work. The smoke probe oracle:driver and the check mode
      oracle-check are the proof on the published binary.
    -->
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.301" />
    <!--
      The MySQL tools (MySql/, Llm/Tools/MySql*Tool.cs, `MySQL tools`, 2026-09-30): read-only queries on MySQL
      and MariaDB over the connections of mysql.json. MySqlConnector, MIT, fully managed (no native DLL), and
      trimming- and NativeAOT-annotated since 2.4.0 — unlike SqlClient and ODP.NET it needs no rooting: the spike
      published clean and ran connect, binds, every type (DECIMAL(65,30) through MySqlDecimal), a READ ONLY
      transaction refusing every write, cancel and the command timeout on MySQL 8.4 and MariaDB 11.8. The smoke
      probe mysql:driver and the check mode mysql-check are the proof on the published binary.
    -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <!--
      The PostgreSQL tools (Postgres/, Llm/Tools/Postgres*Tool.cs, `PostgreSQL tools`, 2026-10-04): read-only queries over the
      connections of postgres.json. Npgsql, PostgreSQL licence, fully managed (no native DLL), NativeAOT-supported since 8.0
      through NpgsqlSlimDataSourceBuilder: the tools build their data source slim and opt into the type handlers a read needs
      (arrays, ranges, records, JSON as text). The smoke probe postgres:driver and the check mode postgres-check are the proof
      on the published binary.
    -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- ODP.NET reaches its own members by reflection: trimmed, LONG columns read empty (see its PackageReference). -->
    <TrimmerRootAssembly Include="Oracle.ManagedDataAccess" />
  </ItemGroup>

  <!--
    KokoroSharp's own CopyContent target is AfterTargets="Build" only, so it never contributes to
    the publish directory. These Content items republish the same files on build AND publish.

    The explicit Link is load-bearing: KokoroSharp resolves voices at AppContext.BaseDirectory/voices
    and espeak-ng at AppContext.BaseDirectory/espeak. Because the globs are rooted at content\voices\
    and content\espeak\, %(RecursiveDir) is empty for the files directly inside them and MSBuild
    would otherwise flatten all of them into the output ROOT, leaving no voices\ directory — then
    KokoroVoiceManager.GetVoice throws a parameterless DirectoryNotFoundException. They also flow
    into the test project's output, which is what lets [KokoroModelFact] find
    voices\ under its BaseDirectory.
  -->
  <ItemGroup>
    <Content Include="$(NuGetPackageRoot)kokorosharp\0.8.0\content\voices\**\*"
             Link="voices\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             Pack="false"
             Visible="false" />
    <Content Include="$(NuGetPackageRoot)kokorosharp\0.8.0\content\espeak\**\*"
             Link="espeak\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             Pack="false"
             Visible="false" />
  </ItemGroup>

  <!--
    The welcome splash pictures (2026-09-18): every picture under the repo's assets\splash (the
    extensions Files/ImageFile.Extensions knows; a notes file beside them stays out, later on
    2026-09-19) rides inside the exe as the manifest resource splash/<name> — UI/SplashImages reads
    the manifest and draws one at random under the banner at startup. Drop a picture into the
    folder and the next build embeds it; nothing ships beside the exe.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\splash\*.png;..\..\assets\splash\*.jpg;..\..\assets\splash\*.jpeg;..\..\assets\splash\*.gif;..\..\assets\splash\*.webp;..\..\assets\splash\*.bmp"
                      LogicalName="splash/%(Filename)%(Extension)"
                      Visible="false" />
    <!-- The repository's LICENSE (GPL-3.0 since 2026-09-20) rides inside the exe too: /about's License tab
         reads it from the manifest (AboutText.LicenseText), so the pane and the file can never disagree. -->
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE" Visible="false" />
    <!-- The execute_code bridge modules (2026-09-21): written beside a run's script so the interpreter finds them
         (Shell/Bridge/CodeLaunch); one per language, plain text, no package to install on the user's side. -->
    <EmbeddedResource Include="Shell\Bridge\neon_tools.py" LogicalName="bridge/neon_tools.py" />
    <EmbeddedResource Include="Shell\Bridge\neon_tools.js" LogicalName="bridge/neon_tools.js" />
    <EmbeddedResource Include="Shell\Bridge\NeonTools.psm1" LogicalName="bridge/NeonTools.psm1" />
    <!-- The TTS voice presets (2026-09-27): the TTS tab's TTS voice preset picker (Speech/VoicePresets). One file per
         built-in since 2026-10-02 (the user's call); a <home>\voices\<name>.json of the user's overrides the built-in of
         that name or adds a preset, as the themes folder does. -->
    <EmbeddedResource Include="..\..\assets\voices\built-in\*.json" LogicalName="voices/built-in/%(Filename)%(Extension)" Visible="false" />
    <!-- The themes (2026-10-05, the user's ask: themes entirely JSON): every assets\themes\<category>\<name>.json is a
         built-in theme (UI/ThemeLibrary), embedded as themes/<category>/<name>.json; add, change or remove a file and the next
         build has it. RecursiveDir keeps the category (with a backslash, which ThemeLibrary turns into a slash); a file loose
         at the root or deeper than one folder is embedded but left out, and ThemeLibraryTests says so. -->
    <EmbeddedResource Include="..\..\assets\themes\**\*.json" LogicalName="themes/%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
    <!-- The default persona (2026-10-03, the user's ask): assets\prompts\persona.md is Assistant.DefaultPersona, what the
         prompt carries without a persona.md and what /persona seeds the file with. Edit the asset; the next build has it. -->
    <EmbeddedResource Include="..\..\assets\prompts\persona.md" LogicalName="prompts/persona.md" Visible="false" />
  </ItemGroup>

  <!--
    No NoWarn block, deliberately. Suppressing an AOT warning on our own code hides a runtime
    bug. Anything genuinely worth silencing gets a local [UnconditionalSuppressMessage] on a
    named member with its reason at the site. (#pragma does nothing for ILC warnings.)
  -->

  <ItemGroup>
    <InternalsVisibleTo Include="NeonSidekick.Tests" />
  </ItemGroup>

</Project>
