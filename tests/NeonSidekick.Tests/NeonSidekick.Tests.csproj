<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Off since 2026-09-23 with the app's (SqlClient refuses invariant mode); ModuleInit pins the cultures as Program.cs does. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 2026-10-05: WebViewHandlerTests call the app-made COM objects through their vtables, as WebView2 does. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Spectre.Console.Testing" Version="0.57.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NeonSidekick\NeonSidekick.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- ~1.8 s of Kokoro (af_heart) saying "Hello, how are you doing today?", resampled 24 -> 16 kHz
         with 300 ms of silence each side. Regenerate with a Kokoro-FastAPI server on :8880:
         POST /v1/audio/speech {"model":"kokoro","input":"Hello, how are you doing today?","voice":"af_heart","response_format":"pcm"}
         then linear-resample the PCM16 24 kHz stream to 16 kHz and write a canonical 44-byte WAV. -->
    <None Include="Fixtures\hello-16k.wav" CopyToOutputDirectory="PreserveNewest" />
    <!-- The same recipe for "Neon, what time is it?" (the wake word followed by a request, in one breath);
         the small Vosk model finalises it as "neon what time is it". -->
    <None Include="Fixtures\neon-16k.wav" CopyToOutputDirectory="PreserveNewest" />
    <!-- Two seconds (4.0-6.0 s, same recipe, voice af_bella) of the assistant reading a story that never
         mentions the wake word ("Two cats watched the same moon from the fence. One was curious, the
         other was sleepy. The curious cat puffed its tail..."): in keyword mode the small Vosk model
         labels a fragment of it "neon" for one partial and takes it back, which is the false interrupt
         seen in the field on 2026-09-11. The regression test pins that the partial flickers and that the
         listener's persistence rule never fires on it. -->
    <None Include="Fixtures\story-16k.wav" CopyToOutputDirectory="PreserveNewest" />
    <!-- A DuckDuckGo HTML results page captured 2026-09-15 (html.duckduckgo.com/html/?q=rust+async+traits&kl=us-en):
         ten result__a anchors with the uddg= redirect, a result__snippet under each. The DuckDuckGo parser is pinned to it. -->
    <None Include="Fixtures\web\ddg-results.html" CopyToOutputDirectory="PreserveNewest" />
    <!-- Claude Code 2.1.283's stream-json captured 2026-09-27 (claude -p, output format stream-json with the partial messages):
         a text reply, a Read then text, a resume of a missing session. Paths scrubbed to C:\work, the init line trimmed,
         the partial tool-input pieces dropped. ClaudeStreamParser is pinned to them. -->
    <None Include="Fixtures\claude\*.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <!-- Home Assistant 2026.9.4's /api/states and the areas template's answer (2026-09-28): a trimmed, hand-made copy of
         a real Hue + Bravia instance's shapes — a room group and its lights, a zone group, an unavailable light, scenes,
         the TV, a remote, a button, a switch, motion, temperature, a low battery, the shopping list. HaSnapshot is pinned to it. -->
    <None Include="Fixtures\ha\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Docker Engine API answers (2026-10-02): hand-made in the shapes engine 29.7.2 (API 1.55, Docker Desktop 4.90) gave over
         \\.\pipe\docker_engine at v1.47 — the container list with compose projects, IPv4 and IPv6 port rows and every health; an
         inspect with fake secrets in every place the redaction covers; stats under cgroup v2 and v1; the images, volumes,
         networks and disk use; a pull's progress lines and a refused pull. The Docker client and tools are pinned to them. -->
    <None Include="Fixtures\docker\*.*" CopyToOutputDirectory="PreserveNewest" />
    <!-- YouTube Data API v3 answers (2026-10-05): hand-made in the shapes the API documents and returns — a search.list with a
         video, a live broadcast, HTML-escaped titles and a channel hit to skip; the videos.list details (a length, P0D for the
         broadcast, a hidden view count); quotaExceeded, an invalid key, the API not enabled, a referrer-restricted key. -->
    <None Include="Fixtures\youtube\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
